<% if park_legal? || park_legal_name.present? %>
  <div class="legal-details">
    <% if park_legal_name.present? %>
      <p class="legal-name">Оператор сайта: <%= park_legal_name %></p>
    <% end %>
    <ul class="legal-meta">
      <% if park_ogrn.present? %>
        <li>ОГРН: <%= park_ogrn %><% if park_registered_on.present? %> от <%= park_registered_on %><% end %></li>
      <% end %>
      <% if park_inn.present? %>
        <li>ИНН: <%= park_inn %></li>
      <% end %>
      <% if park_kpp.present? %>
        <li>КПП: <%= park_kpp %></li>
      <% end %>
      <li>Бренд: Таксопарк Космо</li>
    </ul>
  </div>
<% end %>
