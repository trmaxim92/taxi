<% form_url = local_assigns[:url].presence || yandex_fleet_form_url %>
<% heading = local_assigns.fetch(:heading, "Регистрация в Яндекс Такси") %>
<% lead = local_assigns.fetch(:lead, "Заполните форму — регистрация проходит напрямую в сервисе Яндекс. После отправки с вами свяжутся по правилам сервиса.") %>

<div class="yandex-register" id="<%= local_assigns.fetch(:dom_id, "yandex-register") %>">
  <% unless local_assigns[:hide_intro] %>
    <div class="form-intro">
      <h2><%= heading %></h2>
      <p><%= lead %></p>
    </div>
  <% end %>

  <div class="yandex-register-frame-wrap">
    <iframe
      class="yandex-register-frame"
      title="Форма регистрации Яндекс Такси"
      width="600"
      height="600"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      sandbox="allow-scripts allow-forms allow-same-origin allow-popups allow-popups-to-escape-sandbox allow-top-navigation-by-user-activation"
      src="<%= form_url %>"></iframe>
  </div>
</div>
