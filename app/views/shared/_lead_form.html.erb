<% selected_city_id = local_assigns[:selected_city_id] %>
<% selected_courier_type_id = local_assigns[:selected_courier_type_id] %>
<% submit_label = local_assigns.fetch(:submit_label, "Оставить заявку") %>
<%= form_with model: Lead.new(city_id: selected_city_id, courier_type_id: selected_courier_type_id), url: leads_path, class: "lead-form", data: { turbo: false } do |f| %>
  <div class="hp" aria-hidden="true">
    <label>Company<input type="text" name="company" tabindex="-1" autocomplete="off"></label>
  </div>
  <% if selected_courier_type_id.present? %>
    <%= f.hidden_field :courier_type_id, value: selected_courier_type_id %>
  <% end %>
  <div class="form-grid form-grid-taxi">
    <label>Имя<%= f.text_field :name, required: true, placeholder: "Как к вам обращаться" %></label>
    <label>Телефон
      <%= f.telephone_field :phone,
            required: true,
            placeholder: "+7 (999) 123-45-67",
            inputmode: "tel",
            autocomplete: "tel",
            data: { controller: "phone-mask", action: "input->phone-mask#format" } %>
    </label>
    <label class="form-span-2">Город
      <%= f.collection_select :city_id, cities, :id, :name, { include_blank: "Выберите город", selected: selected_city_id }, required: true %>
    </label>
    <label class="form-span-2">Комментарий
      <%= f.text_area :comment, rows: 3, placeholder: "Необязательно: удобное время звонка или вопрос" %>
    </label>
  </div>
  <label class="checkbox">
    <%= f.check_box :consent, required: true %>
    Согласен на <a class="text-link" href="<%= privacy_path %>/">обработку персональных данных</a>
  </label>
  <%= f.submit submit_label,
        class: "btn btn-primary",
        data: { controller: "analytics", analytics_event_value: "lead_submit_click", action: "click->analytics#track" } %>
<% end %>
