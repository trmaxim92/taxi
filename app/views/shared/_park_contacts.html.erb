<% if park_contacts? %>
  <div class="park-contacts">
    <% if local_assigns[:title].present? %>
      <h2><%= title %></h2>
    <% end %>
    <ul class="park-contacts-list">
      <% if park_phone.present? %>
        <li>
          <span class="park-contacts-label">Телефон</span>
          <a href="<%= phone_href %>"><%= park_phone %></a>
        </li>
      <% end %>
      <% if park_telegram.present? %>
        <li>
          <span class="park-contacts-label">Telegram</span>
          <a href="<%= telegram_href %>" target="_blank" rel="noopener noreferrer"><%= park_telegram %></a>
        </li>
      <% end %>
      <% if park_max.present? %>
        <li>
          <span class="park-contacts-label">MAX</span>
          <a href="<%= max_href %>" target="_blank" rel="noopener noreferrer"><%= park_max %></a>
        </li>
      <% end %>
      <% if park_email.present? %>
        <li>
          <span class="park-contacts-label">Email</span>
          <a href="mailto:<%= park_email %>"><%= park_email %></a>
        </li>
      <% end %>
    </ul>
    <% if registration_available? %>
      <p class="cta-row">
        <%= link_to "Зарегистрироваться самостоятельно", register_path_for, self_register_link_options %>
      </p>
    <% end %>
  </div>
<% end %>
