<% tariffs = local_assigns.fetch(:tariffs) { Tariff.active.ordered } %>
<% note = local_assigns.fetch(:note, true) %>
<% if tariffs.any? %>
  <div class="tariff-grid">
    <% tariffs.each do |tariff| %>
      <article class="tariff-card">
        <p class="tariff-label"><%= tariff.name %></p>
        <p class="tariff-value"><%= tariff.display_value %></p>
        <% if tariff.description.present? %>
          <p class="tariff-desc"><%= tariff.description %></p>
        <% end %>
      </article>
    <% end %>
  </div>
  <% if note %>
    <p class="muted tariff-note">
      Комиссия таксопарка и банковская комиссия — разные составляющие. Вознаграждение сервиса Яндекс Такси, налоговые обязательства и другие удержания не входят в указанные условия Таксопарка Космо.
    </p>
  <% end %>
<% end %>
