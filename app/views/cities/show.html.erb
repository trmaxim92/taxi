<article class="section">
  <div class="container narrow prose">
    <nav class="breadcrumbs" aria-label="Хлебные крошки">
      <a href="<%= root_path %>">Главная</a>
      <span>/</span>
      <a href="<%= goroda_path %>/">Города</a>
      <span>/</span>
      <span><%= @city.name %></span>
    </nav>

    <p class="eyebrow"><%= @city.region %></p>
    <h1><%= @city.h1.presence || "Подключение к Яндекс Такси #{@city.name_prepositional}" %></h1>
    <% if @city.short_description.present? %><p class="lead"><%= @city.short_description %></p><% end %>

    <h2>Работа в Яндекс Такси <%= @city.name_prepositional %> на собственном автомобиле</h2>
    <%= simple_format(@city.unique_text) %>

    <% if @city.connection_conditions.present? %>
      <h2>Условия сотрудничества</h2>
      <%= simple_format(@city.connection_conditions) %>
    <% end %>

    <% if @city.work_features.present? %>
      <h2>Региональная информация</h2>
      <%= simple_format(@city.work_features) %>
    <% end %>

    <h2>Полезные материалы</h2>
    <div class="city-type-links">
      <a class="text-link" href="<%= tarify_path %>/">Тарифы</a>
      <a class="text-link" href="<%= podklyuchenie_path %>/">Подключение</a>
      <a class="text-link" href="<%= rabota_na_svoem_avto_path %>/">Работа на своём авто</a>
      <a class="text-link" href="<%= trebovaniya_path %>/">Требования</a>
      <a class="text-link" href="<%= dokumenty_path %>/">Документы</a>
      <a class="text-link" href="<%= goroda_path %>/">Все города</a>
    </div>
  </div>
</article>

<section class="section section-soft" id="lead-form">
  <div class="container form-wrap form-wrap-taxi">
    <div class="form-intro">
      <h2>Заявка <%= @city.name_prepositional %></h2>
      <p>Укажите контакты — в Таксопарке Космо подскажем по подключению водителя <%= @city.name_prepositional %>.</p>
      <% if registration_available?(city: @city) %>
        <p class="cta-row">
          <%= link_to "Зарегистрироваться самостоятельно", register_path_for(city: @city), self_register_link_options %>
        </p>
      <% end %>
    </div>
    <%= render "shared/lead_form",
          cities: @cities,
          selected_city_id: @city.id,
          submit_label: "Оставить заявку" %>
  </div>
</section>

<% if @faqs.any? %>
<section class="section">
  <div class="container narrow">
    <h2>Частые вопросы</h2>
    <%= render "shared/faq", faqs: @faqs %>
  </div>
</section>
<% end %>
