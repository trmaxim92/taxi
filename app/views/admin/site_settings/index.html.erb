<h1>Настройки сайта</h1>
<p class="muted">Контакты и юр. данные: <code>contact_phone</code>, <code>contact_telegram</code>, <code>contact_max</code>, <code>contact_email</code>, <code>yandex_fleet_form_url</code>, <code>legal_*</code>.</p>
<table class="admin-table">
  <thead><tr><th>Ключ</th><th>Значение</th><th></th></tr></thead>
  <tbody>
    <% @site_settings.each do |setting| %>
      <tr>
        <td><%= setting.key %></td>
        <td><%= truncate(setting.value.to_s, length: 80) %></td>
        <td><%= link_to "Изменить", edit_admin_site_setting_path(setting) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
