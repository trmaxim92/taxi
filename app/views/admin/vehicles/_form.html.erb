<%= form_with model: [:admin, vehicle], class: "lead-form" do |f| %>
  <% if vehicle.errors.any? %><div class="flash flash-alert"><%= vehicle.errors.full_messages.to_sentence %></div><% end %>
  <div class="form-grid">
    <label>Марка<%= f.text_field :brand, required: true %></label>
    <label>Модель<%= f.text_field :model, required: true %></label>
    <label>Slug<%= f.text_field :slug, placeholder: "hyundai-solaris" %></label>
    <label>Год от<%= f.number_field :year_from %></label>
    <label>Год до<%= f.number_field :year_to %></label>
    <label>Класс<%= f.text_field :vehicle_class, placeholder: "Эконом" %></label>
    <label>Тарифы (через запятую)<%= f.text_field :tariffs, placeholder: "Эконом, Комфорт" %></label>
    <label>Регион<%= f.text_field :region, placeholder: "Россия / Москва" %></label>
    <label>Источник<%= f.text_field :source %></label>
    <label>Дата проверки<%= f.date_field :verified_on %></label>
    <label>Позиция<%= f.number_field :position %></label>
    <label>SEO Title<%= f.text_field :seo_title %></label>
    <label>SEO Description<%= f.text_field :seo_description %></label>
    <label>H1<%= f.text_field :h1 %></label>
    <label>Robots<%= f.text_field :robots_meta %></label>
  </div>
  <label>Примечание<%= f.text_area :note, rows: 4 %></label>
  <label class="checkbox"><%= f.check_box :published %> Опубликовано</label>
  <label class="checkbox"><%= f.check_box :is_indexable %> В индекс (только с источником и датой проверки)</label>
  <%= f.submit "Сохранить", class: "btn btn-primary" %>
<% end %>
