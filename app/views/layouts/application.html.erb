<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <title><%= page_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= meta_description %>">
    <meta name="robots" content="<%= robots_meta_content %>">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="120x120">
    <link rel="apple-touch-icon" href="/favicon.svg">
    <link rel="canonical" href="<%= canonical_url %>">
    <meta property="og:title" content="<%= seo_meta[:og_title].presence || page_title %>">
    <meta property="og:description" content="<%= seo_meta[:og_description].presence || meta_description %>">
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= canonical_url %>">
    <meta property="og:image" content="<%= seo_meta[:og_image].presence || "#{request.base_url}/images/hero-taxi.jpg" %>">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:image" content="<%= seo_meta[:og_image].presence || "#{request.base_url}/images/hero-taxi.jpg" %>">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= render "shared/schema", faqs: @faqs %>
    <% metrika_id = SiteSetting.get("yandex_metrika_id", "") rescue "" %>
    <% ga4_id = SiteSetting.get("ga4_id", "") rescue "" %>
    <% if metrika_id.present? %>
      <script>window.YANDEX_METRIKA_ID = <%= raw metrika_id.to_json %>;</script>
    <% end %>
    <% if ga4_id.present? %>
      <script async src="https://www.googletagmanager.com/gtag/js?id=<%= ga4_id %>"></script>
      <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', '<%= ga4_id %>', { anonymize_ip: true });
      </script>
    <% end %>
  </head>
  <body class="theme-taxi">
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="<%= root_path %>">
          <span class="brand-mark brand-mark-ya">К</span>
          <span class="brand-text">Таксопарк Космо</span>
        </a>
        <nav class="nav" aria-label="Основная навигация">
          <a href="<%= tarify_path %>/">Тарифы</a>
          <a href="<%= podklyuchenie_path %>/">Подключение</a>
          <a href="<%= rabota_na_svoem_avto_path %>/">Своё авто</a>
          <a href="<%= goroda_path %>/">Города</a>
          <a href="<%= o_kompanii_path %>/">О компании</a>
        </nav>
        <div class="header-actions">
          <a class="btn btn-primary btn-sm" href="<%= root_path %>#lead-form">Подключиться</a>
        </div>
      </div>
    </header>

    <% if notice.present? %><div class="flash flash-notice container"><%= notice %></div><% end %>
    <% if alert.present? %><div class="flash flash-alert container"><%= alert %></div><% end %>

    <main>
      <%= yield %>
    </main>

    <footer class="site-footer site-footer-taxi">
      <div class="container footer-taxi">
        <div class="footer-taxi-top">
          <a class="brand" href="<%= root_path %>">
            <span class="brand-mark brand-mark-ya">К</span>
            <span class="brand-text">Таксопарк Космо</span>
          </a>
          <nav class="footer-nav" aria-label="Навигация в подвале">
            <a href="<%= o_kompanii_path %>/">О компании</a>
            <a href="<%= tarify_path %>/">Тарифы</a>
            <a href="<%= podklyuchenie_path %>/">Подключение</a>
            <a href="<%= trebovaniya_path %>/">Требования</a>
            <a href="<%= dokumenty_path %>/">Документы</a>
            <a href="<%= faq_path %>/">FAQ</a>
            <a href="<%= goroda_path %>/">Города</a>
            <a href="<%= kontakty_path %>/">Контакты</a>
            <a href="<%= privacy_path %>/">Конфиденциальность</a>
            <a href="<%= agreement_path %>/">Соглашение</a>
          </nav>
        </div>

        <% if park_contacts? || registration_available? %>
          <div class="footer-contacts">
            <% if park_phone.present? %>
              <a href="<%= phone_href %>"><%= park_phone %></a>
            <% end %>
            <% if park_telegram.present? %>
              <a href="<%= telegram_href %>" target="_blank" rel="noopener noreferrer">Telegram</a>
            <% end %>
            <% if park_max.present? %>
              <a href="<%= max_href %>" target="_blank" rel="noopener noreferrer">MAX</a>
            <% end %>
            <% if registration_available? %>
              <%= link_to "Саморегистрация", register_path_for, self_register_link_options.merge(class: "footer-register-link") %>
            <% end %>
          </div>
        <% end %>

        <%= render "shared/legal_details" %>

        <p class="footer-disclaimer">
          Сайт принадлежит <%= park_legal_name %> (бренд Космо) — сертифицированному партнёру Яндекс Такси.
          Работа рассматривается только на собственном автомобиле водителя. Доход зависит от заказов, города, тарифа и расходов — гарантированную сумму заработка мы не обещаем.
        </p>
      </div>
    </footer>
  </body>
</html>
