      [ "Требуется ли специальная лицензия?", "Правильно документ называется разрешение на деятельность такси. Самозанятым и ИП, как правило, нужно встать в реестр перевозчиков и получить разрешение. Вариант с трудовым договором через таксопарк тоже возможен — детали уточним при заявке." ],
      [ "Можно ли самостоятельно выбирать график и районы?", "Да. Время выхода на линию водитель выбирает сам. В Яндекс Про есть режимы «Мой район» и «По делам»: заказы предлагаются с выбранной территории, у режимов есть особенности." ],
      [ "Какое приложение используется для работы?", "Для заказов, карты, истории дохода и поддержки используется Яндекс Про. При споре с пассажиром можно нажать «Конфликт» на главном экране и при необходимости передать запись в поддержку." ],
      [ "Есть ли лимит на количество заказов?", "По информации сервиса, лимита по числу заказов в день для самозанятых и ИП-водителей авто нет. При этом часы за рулём не должны превышать нормы законодательства." ],
      [ "Сколько можно заработать?", "Доход зависит от заказов, времени на линии, тарифа, города и расходов. Гарантированную сумму заработка обещать нельзя." ],
      [ "Как подключиться через таксопарк Космо?", "Оставьте заявку на сайте. Поможем с подключением на собственном автомобиле, документами и регистрацией в Яндекс Про." ]
    ]

    Faq.where(page_scope: "home").delete_all
    faqs.each_with_index do |(question, answer), index|
      Faq.create!(question: question, answer: answer, page_scope: "home", published: true, position: index)
    end
    puts "FAQs home: #{faqs.size}"

    scoped_faqs = {
      "usloviya-raboty" => [
        [ "Как формируется доход?", "Доход зависит от заказов, тарифа, города, времени на линии и расходов. Гарантированную сумму обещать нельзя." ],
        [ "Где смотреть комиссии парка?", "Коммерческие условия таксопарка Космо уточняются до старта и редактируются в административной панели. Неподтверждённые цифры не публикуем." ]
      ],
      "trebovaniya-k-voditelyam" => [
        [ "Откуда данные про возраст и стаж?", "Ориентир 21+ и стаж от 3 лет — по данным официальной страницы сервиса taxi.yandex.ru/rabota/driver. Условия могут отличаться." ],
        [ "Нужно ли разрешение на деятельность такси?", "Самозанятым и ИП, как правило, нужно разрешение и реестр перевозчиков. Вариант с трудовым договором через парк тоже возможен." ]
      ],
      "rabota-na-svoem-avto" => [
        [ "Есть ли аренда авто?", "Нет. На сайте таксопарка Космо рассматривается только работа на собственном автомобиле." ],
        [ "Где проверить модель?", "В каталоге публикуются только модели с источником и датой проверки. Иначе оставьте заявку." ]
      ],
      "tarify" => [
        [ "Какой тариф мне доступен?", "Зависит от автомобиля, года выпуска, региона и правил сервиса. Уточняйте при подключении." ]
      ],
      "yandex-pro" => [
        [ "Можно ли выбирать район заказов?", "В приложении есть режимы «Мой район» и «По делам». У режимов есть особенности." ]
      ],
      "kak-ustroitsya" => [
        [ "С чего начать?", "Оставьте заявку, подготовьте документы и автомобиль, пройдите регистрацию в Яндекс Про." ]
      ]
    }

    scoped_faqs.each do |scope, items|
      Faq.where(page_scope: scope).delete_all
      items.each_with_index do |(question, answer), index|
        Faq.create!(question: question, answer: answer, page_scope: scope, published: true, position: index)
      end
      puts "FAQs #{scope}: #{items.size}"
    end

    # Example vehicles — unpublished until verified in admin (do not invent admissions)
    [
      { brand: "Hyundai", model: "Solaris", slug: "hyundai-solaris", vehicle_class: "Эконом", tariffs: "Эконом", region: "Россия" },
      { brand: "Kia", model: "Rio", slug: "kia-rio", vehicle_class: "Эконом", tariffs: "Эконом", region: "Россия" }
    ].each_with_index do |attrs, index|
      vehicle = Vehicle.find_or_initialize_by(slug: attrs[:slug])
      vehicle.assign_attributes(
        attrs.merge(
          note: "Шаблон карточки. Опубликуйте только после проверки по актуальному классификатору сервиса.",
          source: nil,
          verified_on: nil,
          published: false,
          is_indexable: false,
          position: index,
          seo_title: "#{attrs[:brand]} #{attrs[:model]} для Яндекс Такси — требования",
          seo_description: "Проверьте, подходит ли #{attrs[:brand]} #{attrs[:model]} для работы в Яндекс Такси.",
          h1: "#{attrs[:brand]} #{attrs[:model]} для Яндекс Такси"
        )
      )
      vehicle.save!
      puts "Vehicle draft: #{vehicle.slug}"
    end

    Rake::Task["taxi:seed_cities"].invoke

    puts "taxi:seed_content complete"
  end
end
